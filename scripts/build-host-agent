#!/usr/bin/env bash
set -euo pipefail

target="${1:-aarch64-apple-darwin}"
bin="host-agent"
if [[ "$target" == *windows* ]]; then
  bin="host-agent.exe"
fi

artifact_dir="apps/host-agent/artifacts/${target}"

RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C panic=abort -C lto=fat -C embed-bitcode=yes" \
  cargo build -p host-agent --release --target "$target"
mkdir -p "$artifact_dir"
cp "target/${target}/release/${bin}" "${artifact_dir}/${bin}"

echo "host-agent copied to ${artifact_dir}/${bin}"
