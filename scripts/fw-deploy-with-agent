#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/.." && pwd)"

detect_host_target() {
  if command -v rustc >/dev/null 2>&1; then
    rustc -vV | awk '/^host:/ {print $2; exit}'
    return 0
  fi

  local os=""
  local arch=""
  os="$(uname -s)"
  arch="$(uname -m)"

  case "${arch}:${os}" in
    arm64:Darwin | aarch64:Darwin) echo "aarch64-apple-darwin" ;;
    x86_64:Darwin) echo "x86_64-apple-darwin" ;;
    x86_64:Linux) echo "x86_64-unknown-linux-gnu" ;;
    aarch64:Linux | arm64:Linux) echo "aarch64-unknown-linux-gnu" ;;
    *)
      echo "unsupported host platform: arch=${arch} os=${os}" >&2
      exit 1
      ;;
  esac
}

host_target="${HOST_AGENT_TARGET:-$(detect_host_target)}"

echo "[fw-deploy-with-agent] Building host-agent for ${host_target}"
"${repo_root}/scripts/build-host-agent" "${host_target}"

echo "[fw-deploy-with-agent] Running firmware deploy"
cd "${repo_root}"
exec cargo run -p pico_rust --release --target thumbv8m.main-none-eabihf "$@"
