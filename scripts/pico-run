#!/usr/bin/env bash
set -euo pipefail

# Simple Cargo runner for Raspberry Pi Pico / Pico W / Pico 2W (USB only, macOS-friendly)
# 1) Flash ELF via picotool
# 2) Wait for a USB CDC ACM port (prefers /dev/cu.* on macOS)
# 3) Stream logs until interrupted

# Basic flags (passed after the ELF):
#   --no-wait           Flash and exit (do not wait for CDC)
#   --timeout=<secs>    Wait up to <secs> for CDC (overrides env)

if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <path-to-elf> [--no-wait] [--timeout=<secs>] [args...]" >&2
  exit 2
fi

ELF="$1"
shift || true
NO_WAIT=0
CLI_TIMEOUT=""
for arg in "$@"; do
  case "$arg" in
    --no-wait) NO_WAIT=1 ;;
    --timeout=*) CLI_TIMEOUT="${arg#--timeout=}" ;;
  esac
done

if ! command -v picotool >/dev/null 2>&1; then
  echo "picotool not found in PATH" >&2
  exit 2
fi

print_firmware_size() {
  local size_tool=""
  local size_output=""
  local size_line=""
  local text=""
  local data=""
  local bss=""

  format_mb() {
    local bytes="$1"

    if command -v awk >/dev/null 2>&1; then
      awk -v b="$bytes" 'BEGIN {printf "%.1f", b/1024/1024}'
      return 0
    fi

    if command -v python3 >/dev/null 2>&1; then
      python3 - "$bytes" <<'PY'
import sys
try:
    b = float(sys.argv[1])
except Exception:
    b = 0.0
print(f"{b/1024/1024:.1f}", end="")
PY
      return 0
    fi

    printf "%s" "$bytes"
  }

  find_size_tool() {
    local tool=""

    for tool in arm-none-eabi-size llvm-size; do
      if command -v "$tool" >/dev/null 2>&1; then
        echo "$tool"
        return 0
      fi
    done

    if command -v rustc >/dev/null 2>&1; then
      local sysroot=""
      local host=""
      local candidate=""

      sysroot="$(rustc --print sysroot 2>/dev/null || true)"
      host="$(rustc -Vv 2>/dev/null | awk '/^host:/ {print $2; exit}')"
      if [[ -n "$sysroot" && -n "$host" ]]; then
        candidate="$sysroot/lib/rustlib/$host/bin/llvm-size"
        if [[ -x "$candidate" ]]; then
          echo "$candidate"
          return 0
        fi
      fi
    fi

    if [[ "$(uname -s)" != "Darwin" ]] && command -v size >/dev/null 2>&1; then
      echo "size"
      return 0
    fi

    return 1
  }

  python_elf_size() {
    command -v python3 >/dev/null 2>&1 || return 1
    python3 - "$ELF" <<'PY'
import struct
import sys

path = sys.argv[1]
try:
    with open(path, "rb") as f:
        data = f.read()
except OSError:
    sys.exit(1)

if len(data) < 16 or data[:4] != b"\x7fELF":
    sys.exit(1)

ei_class = data[4]
ei_data = data[5]
if ei_data == 1:
    endian = "<"
elif ei_data == 2:
    endian = ">"
else:
    sys.exit(1)

if ei_class == 1:
    hdr_fmt = endian + "HHIIIIIHHHHHH"
    sh_fmt = endian + "IIIIIIIIII"
elif ei_class == 2:
    hdr_fmt = endian + "HHIQQQIHHHHHH"
    sh_fmt = endian + "IIQQQQIIQQ"
else:
    sys.exit(1)

hdr_size = struct.calcsize(hdr_fmt)
if len(data) < 16 + hdr_size:
    sys.exit(1)

hdr = struct.unpack_from(hdr_fmt, data, 16)
e_shoff = hdr[5]
e_shentsize = hdr[10]
e_shnum = hdr[11]

if e_shoff == 0 or e_shnum == 0 or e_shentsize == 0:
    sys.exit(1)

sh_size = struct.calcsize(sh_fmt)
if e_shentsize < sh_size:
    sys.exit(1)

SHF_WRITE = 0x1
SHF_ALLOC = 0x2
SHT_NOBITS = 8

text = 0
data_size = 0
bss = 0

for i in range(e_shnum):
    off = e_shoff + i * e_shentsize
    if off + sh_size > len(data):
        sys.exit(1)
    sh = struct.unpack_from(sh_fmt, data, off)
    sh_type = sh[1]
    sh_flags = sh[2]
    sh_size_bytes = sh[5]

    if (sh_flags & SHF_ALLOC) == 0:
        continue
    if sh_type == SHT_NOBITS:
        bss += sh_size_bytes
    elif (sh_flags & SHF_WRITE) != 0:
        data_size += sh_size_bytes
    else:
        text += sh_size_bytes

print(f"{text} {data_size} {bss}")
PY
  }

  print_elf_size_fallback() {
    local reason="$1"
    local bytes=""

    if [[ -f "$ELF" ]]; then
      if stat -f%z "$ELF" >/dev/null 2>&1; then
        bytes="$(stat -f%z "$ELF")"
      elif stat -c%s "$ELF" >/dev/null 2>&1; then
        bytes="$(stat -c%s "$ELF")"
      elif command -v wc >/dev/null 2>&1; then
        bytes="$(wc -c < "$ELF" | tr -d '[:space:]')"
      fi
    fi

    if [[ -n "$bytes" ]]; then
      echo "[pico-run] Firmware size: elf=$(format_mb "$bytes")MB (file size; ${reason})"
    else
      echo "[pico-run] Firmware size: (${reason})"
    fi
  }

  size_tool="$(find_size_tool || true)"

  if [[ -z "$size_tool" ]]; then
    if size_line="$(python_elf_size 2>/dev/null)"; then
      read -r text data bss <<<"$size_line"
      if [[ -n "$text" && -n "$data" && -n "$bss" ]]; then
        local flash=$((text + data))
        local ram=$((data + bss))
        echo "[pico-run] Firmware size: flash=$(format_mb "$flash")MB (text+data), ram=$(format_mb "$ram")MB (data+bss)"
        return 0
      fi
    fi
    print_elf_size_fallback "no size tool found"
    return 0
  fi

  if ! size_output="$("$size_tool" "$ELF" 2>/dev/null)"; then
    if size_line="$(python_elf_size 2>/dev/null)"; then
      read -r text data bss <<<"$size_line"
      if [[ -n "$text" && -n "$data" && -n "$bss" ]]; then
        local flash=$((text + data))
        local ram=$((data + bss))
        echo "[pico-run] Firmware size: flash=$(format_mb "$flash")MB (text+data), ram=$(format_mb "$ram")MB (data+bss)"
        return 0
      fi
    fi
    print_elf_size_fallback "failed to run ${size_tool}"
    return 0
  fi

  size_line="$(printf '%s\n' "$size_output" | awk 'NF >= 3 && $1 ~ /^[0-9]+$/ {print $1, $2, $3; exit}')"
  if [[ -z "$size_line" ]]; then
    if size_line="$(python_elf_size 2>/dev/null)"; then
      read -r text data bss <<<"$size_line"
      if [[ -n "$text" && -n "$data" && -n "$bss" ]]; then
        local flash=$((text + data))
        local ram=$((data + bss))
        echo "[pico-run] Firmware size: flash=$(format_mb "$flash")MB (text+data), ram=$(format_mb "$ram")MB (data+bss)"
        return 0
      fi
    fi
    print_elf_size_fallback "unparsed; run '${size_tool} ${ELF}' for details"
    return 0
  fi

  read -r text data bss <<<"$size_line"
  if [[ -z "$text" || -z "$data" || -z "$bss" ]]; then
    if size_line="$(python_elf_size 2>/dev/null)"; then
      read -r text data bss <<<"$size_line"
      if [[ -n "$text" && -n "$data" && -n "$bss" ]]; then
        local flash=$((text + data))
        local ram=$((data + bss))
        echo "[pico-run] Firmware size: flash=$(format_mb "$flash")MB (text+data), ram=$(format_mb "$ram")MB (data+bss)"
        return 0
      fi
    fi
    print_elf_size_fallback "unparsed; run '${size_tool} ${ELF}' for details"
    return 0
  fi

  local flash=$((text + data))
  local ram=$((data + bss))
  echo "[pico-run] Firmware size: flash=$(format_mb "$flash")MB (text+data), ram=$(format_mb "$ram")MB (data+bss)"
}

print_firmware_size

echo "[pico-run] Flashing: $ELF"
picotool load -u -v -x -t elf "$ELF"

if [[ $NO_WAIT -eq 1 ]]; then
  echo "[pico-run] Skipping serial wait (--no-wait)."
  exit 0
fi

echo "[pico-run] Waiting for USB CDC device..."
PORT=""
# Timeout in seconds. Default 120; override with CLI --timeout or env PICO_WAIT_USB_TIMEOUT.
WAIT_SECS="${CLI_TIMEOUT:-${PICO_WAIT_USB_TIMEOUT:-120}}"
if [[ "${WAIT_SECS}" =~ ^[0-9]+$ ]] && [[ "$WAIT_SECS" -gt 0 ]]; then
  deadline=$((SECONDS + WAIT_SECS))
else
  deadline=0
fi

find_port() {
  # Prefer macOS call-out devices first, then others; include common Linux names.
  ls /dev/cu.usbmodem* /dev/tty.usbmodem* /dev/ttyACM* /dev/ttyUSB* 2>/dev/null | head -n1 || true
}

while [[ -z "$PORT" && ( $deadline -eq 0 || $SECONDS -lt $deadline ) ]]; do
  PORT=$(find_port)
  [[ -z "$PORT" ]] && sleep 0.2
done

if [[ -z "$PORT" ]]; then
  echo "[pico-run] No serial device found within timeout."
  echo "             Hint: The firmware enables USB only after an HTTP trigger."
  echo "             Open http://192.168.4.1/ and click Start USB,"
  echo "             or curl -X POST 'http://192.168.4.1/usb/register?assistant=1&os=mac'"
  exit 1
fi

echo "[pico-run] Using port: $PORT"

# Best-effort TTY init: pick the right flag for stty depending on platform
if command -v stty >/dev/null 2>&1; then
  if stty --help 2>&1 | grep -q -- "usage: stty \[-a"; then
    # Likely macOS/BSD: uses -f
    stty -f "$PORT" 115200 -echo -ixon -icrnl -opost raw -hupcl clocal 2>/dev/null || true
  else
    # Likely GNU/Linux: uses -F
    stty -F "$PORT" 115200 -echo -ixon -icrnl -opost raw -hupcl clocal 2>/dev/null || true
  fi
fi

# Open the port read/write (asserts DTR on many CDC-ACM stacks)
exec 3<>"$PORT"

# Cleanly close on Ctrl-C
cleanup() {
  exec 3<&- || true
  echo
  echo "[pico-run] Closed."
}
trap cleanup INT TERM

echo "[pico-run] Streaming logs (Ctrl-C to stop)…"
# Reminder for first-time users
echo "[pico-run] Tip: If nothing prints, trigger USB over Wi‑Fi (http://192.168.4.1)."
# Foreground cat so logs stream until you interrupt or the device disconnects
set +e
cat <&3
code=$?
set -e

cleanup
exit $code
